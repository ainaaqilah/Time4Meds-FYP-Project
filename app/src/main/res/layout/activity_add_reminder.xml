<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/vibrant_button_gradient"
        android:padding="32dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="-50dp"
            android:layout_marginTop="-50dp"
            android:background="@drawable/circle_overlay_light"
            android:alpha="0.2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="35dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule Dose"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set the time and dosage for medication."
                android:textColor="#E0F7FA"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:layout_marginTop="-40dp"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT MEDICATION *"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerMedName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_spinner"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOSAGE *"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etDosage"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="e.g. 1 Tablet"
                    android:background="@drawable/rounded_edittext"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp"
                    android:inputType="text"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME *"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etTime"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Select time"
                    android:background="@drawable/rounded_edittext"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION *"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etStartDate"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="Start Date"
                        android:background="@drawable/rounded_edittext"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:focusable="false"
                        android:clickable="true" />

                    <EditText
                        android:id="@+id/etEndDate"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:hint="End Date"
                        android:background="@drawable/rounded_edittext"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:focusable="false"
                        android:clickable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSave"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Save"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:background="@drawable/vibrant_button_gradient"
                        android:elevation="4dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCancel"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="Cancel"
                        android:textColor="#94A3B8"
                        android:textAllCaps="false"
                        android:background="?attr/selectableItemBackground"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDelete"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="Delete Reminder"
                        android:textColor="#EF4444"
                        android:textAllCaps="false"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</RelativeLayout>