<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/topFlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 AM"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#00B4DB"
                android:background="@drawable/bg_filter_chip"
                android:backgroundTint="#F0FDFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:background="#F1F5F9" />

            <View
                android:id="@+id/viewStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/status_circle_gray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentFlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topFlow"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/vibrant_button_gradient"
                    android:alpha="0.08" />

                <ImageView
                    android:id="@+id/ivPillIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medication Name"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#1E293B"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/tvDosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosage Info"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTaken"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/contentFlow"
            android:layout_marginTop="20dp"
            android:text="Mark as Taken"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="false"
            android:background="@drawable/vibrant_button_gradient"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>