<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="-220dp"
        android:background="@drawable/vibrant_button_gradient"
        android:alpha="0.08" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="60dp"
                android:paddingBottom="28dp"
                android:gravity="center_vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/placeholder"
                    app:civ_border_width="3dp"
                    app:civ_border_color="#FFFFFF"
                    android:elevation="4dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:id="@+id/tvCurrentlyManaging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Care Manager For"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:textColor="#64748B"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvElderlyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elderly Name"
                        android:textSize="40sp"
                        android:textColor="#1E293B"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProfileAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Age: 80"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="12dp"
                            android:background="#CBD5E1"
                            android:layout_marginHorizontal="12dp"/>

                        <TextView
                            android:id="@+id/tvProfileGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gender: Male"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileMedical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Medical Info: None"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvProfileContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Emergency Contact: None"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:background="@drawable/outline_button_red"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#EF4444" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvNextMedicationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next Medication"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#EF4444"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvNextMedication"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No upcoming medication"
                        android:textSize="15sp"
                        android:textColor="#1E293B"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <GridLayout
                android:id="@+id/containerCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <LinearLayout
                    android:id="@+id/cardMedication"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/modern_input_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_meds"
                        app:tint="#0ea5e9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medications"
                        android:textColor="#1E293B"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardReminders"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/modern_input_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_reminder"
                        app:tint="#0ea5e9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reminders"
                        android:textColor="#1E293B"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardChecklist"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/modern_input_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_checklist"
                        app:tint="#0ea5e9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Checklist"
                        android:textColor="#1E293B"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardSOS"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/vibrant_button_gradient"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sos"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOS Alert"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/modern_input_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/navProfiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:src="@drawable/ic_profiles"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#94A3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profiles"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:src="@drawable/ic_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#00B4DB" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00B4DB"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHelp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:src="@drawable/ic_help"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#94A3B8" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>