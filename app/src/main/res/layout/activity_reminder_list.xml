<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/vibrant_button_gradient"
        android:padding="32dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="-50dp"
            android:layout_marginTop="-50dp"
            android:background="@drawable/circle_overlay_light"
            android:alpha="0.2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="35dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminders"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track daily medication schedules."
                android:textColor="#E0F7FA"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:layout_marginTop="-40dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">

            <LinearLayout
                android:id="@+id/filterButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:weightSum="3">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAll"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_filter_chip"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#00B4DB"
                    android:fontFamily="sans-serif-medium"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToday"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:text="Today"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#00B4DB"
                    android:fontFamily="sans-serif-medium"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUpcoming"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_filter_chip"
                    android:text="Upcoming"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#00B4DB"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewReminders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/filterButtonsLayout"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="100dp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="No reminders available.\nPlease add a reminder."
                android:textColor="#94A3B8"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:letterSpacing="-0.02"
                android:visibility="gone" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/navProfiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profiles"
                    app:tint="#94A3B8" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profiles"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="#00B4DB" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textColor="#00B4DB"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHelp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_help"
                    app:tint="#94A3B8" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottomNav"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        android:backgroundTint="#00B4DB"
        app:fabSize="normal"
        app:borderWidth="0dp"
        app:elevation="8dp"/>

</RelativeLayout>