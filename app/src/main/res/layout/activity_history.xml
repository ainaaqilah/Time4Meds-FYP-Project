<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/vibrant_button_gradient"
        android:padding="32dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="-50dp"
            android:layout_marginTop="-50dp"
            android:background="@drawable/circle_overlay_light"
            android:alpha="0.2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="35dp">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medication Daily Checklist"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review your companion past adherence logs."
                android:textColor="#E0F7FA"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:layout_marginTop="-40dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">

            <LinearLayout
                android:id="@+id/filterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:weightSum="2"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerFilterRange"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner"
                    android:paddingHorizontal="8dp"
                    android:spinnerMode="dropdown" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCustomRange"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_filter_chip"
                    android:backgroundTint="#F1F5F9"
                    android:text="Custom Range"
                    android:textAllCaps="false"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/filterContainer"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="100dp"
                android:scrollbars="vertical" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>